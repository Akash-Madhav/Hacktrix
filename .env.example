# ==============================================================================
# AICTE BluePill / Hacktrix Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Neon connection string format:
# postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
# Or pooled connection string (recommended for serverless):
# postgresql://[user]:[password]@[neon-hostname]-pooler.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://alex:your_neon_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=True
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME="AICTE BluePill Validation Workbench"
APP_VERSION="1.0.0"
DEBUG=True

# ------------------------------------------------------------------------------
# LLM & AI Engine (Ollama Qwen 2.5)
# ------------------------------------------------------------------------------
LLM_ENABLED=True
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"

# ------------------------------------------------------------------------------
# Simulation & Execution Mode
# ------------------------------------------------------------------------------
SIMULATION_MODE=True
