# ==============================================================================
# AICTE BluePill Automated Application Validation Workbench - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Large Model Weights & GGUF Vault (GitHub rejects files > 100MB)
# ------------------------------------------------------------------------------
models/*.gguf
models/*.bin
models/*.safetensors
models/*.pt
models/*.onnx
!models/README.md
!models/Modelfile

# ------------------------------------------------------------------------------
# 2. Python & Runtime Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller & Testing
*.manifest
*.spec
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 3. Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 4. Database & Local State
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
bluepill.db

# ------------------------------------------------------------------------------
# 5. Uploads & Generated Test Data
# ------------------------------------------------------------------------------
uploads/*
!uploads/.gitkeep
# Ignore runtime-generated college dossiers while preserving base synthetic benchmarks
synthetic_data/app-*/
synthetic_data/*.tmp

# ------------------------------------------------------------------------------
# 6. Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend-react/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/

# ------------------------------------------------------------------------------
# 7. Environment & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------------------------
# 8. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
